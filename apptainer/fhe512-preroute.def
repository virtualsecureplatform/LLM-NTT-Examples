Bootstrap: docker
From: ubuntu:22.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        bash ca-certificates coreutils g++ git iverilog make openjdk-17-jre-headless \
        python3 python3-pip yosys
    python3 -m pip install --no-cache-dir verilator==5.38.0
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export LANG=C.UTF-8

%labels
    Author LLM-NTT-Examples
    Purpose N512 pre-route NGen/SGen grid with Icarus, Verilator, and Yosys
